{
  "name": "briga-video-generator",
  "version": "0.1.0",
  "private": true,
  "description": "UOW-1 implementation for experience and orchestration",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run tests/e2e/pipelineLiveProviders.e2e.test.ts",
    "test:watch": "vitest",
    "start": "node dist/src/uow-1-experience-orchestration/api/server.js",
    "dev": "tsx src/uow-1-experience-orchestration/api/server.ts",
    "start:uow2": "node dist/src/uow-2-content-intelligence/api/server.js",
    "dev:uow2": "tsx src/uow-2-content-intelligence/api/server.ts",
    "start:uow3": "node dist/src/uow-3-media-composition/api/server.js",
    "dev:uow3": "tsx src/uow-3-media-composition/api/server.ts",
    "start:uow4": "node dist/src/uow-4-platform-packaging/api/server.js",
    "dev:uow4": "tsx src/uow-4-platform-packaging/api/server.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.8.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "fast-check": "^3.19.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
