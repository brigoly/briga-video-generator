# UOW-1 Orchestration Environment Template
NODE_ENV=development
PORT=3000
UOW2_PORT=3001
ORCH_BEARER_TOKEN=dev-local-token
QUEUE_TTL_SECONDS=30
STATUS_CACHE_TTL_SECONDS=3
UOW1_USE_IN_MEMORY=false
UOW1_PERSIST_ROOT_DIR=artifacts/uow1-runtime
UOW1_ENABLE_PUBLISH_STAGE=false
RUN_LIVE_PROVIDER_TESTS=false

# UOW-2 Content Intelligence (Ollama + Llama3)
UOW2_OLLAMA_BASE_URL=http://localhost:11434
UOW2_OLLAMA_MODEL=llama3
UOW2_OLLAMA_PROVIDER_ID=ollama-llama3
UOW2_OLLAMA_TIMEOUT_MS=60000
UOW2_REQUIRE_REAL_PROVIDER=false

# Optional cloud fallback (used when local endpoint is unavailable)
UOW2_OLLAMA_CLOUD_BASE_URL=
UOW2_OLLAMA_CLOUD_API_KEY=

# UOW-3 Media Composition
UOW3_PORT=3002
UOW3_REQUIRE_REAL_PROVIDER=false
UOW3_PEXELS_API_KEY=
UOW3_PEXELS_BASE_URL=https://api.pexels.com
UOW3_PIXABAY_API_KEY=
UOW3_PIXABAY_BASE_URL=https://pixabay.com
UOW3_POLLINATIONS_BASE_URL=https://image.pollinations.ai

# UOW-4 Platform Packaging
UOW4_PORT=3003
UOW4_REQUIRE_REAL_PROVIDER=false
UOW4_ARTIFACT_PROVIDER_LOCAL_BASE_URL=
UOW4_ARTIFACT_PROVIDER_CLOUD_BASE_URL=
UOW4_ARTIFACT_PROVIDER_CLOUD_API_KEY=
UOW4_ARTIFACT_PROVIDER_TIMEOUT_MS=30000
UOW4_REQUIRE_REAL_PUBLISHER=false
UOW4_YOUTUBE_PUBLISH_BASE_URL=
UOW4_YOUTUBE_PUBLISH_API_KEY=
UOW4_YOUTUBE_PUBLISH_TIMEOUT_MS=45000
UOW4_YOUTUBE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
UOW4_YOUTUBE_OAUTH_CLIENT_ID=
UOW4_YOUTUBE_OAUTH_CLIENT_SECRET=
UOW4_YOUTUBE_OAUTH_REFRESH_TOKEN=
UOW4_YOUTUBE_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube.upload

# UOW-5 Runtime Hook Controls
UOW5_ENABLE_RUNTIME_HOOKS=true
UOW5_ARTIFACT_ROOT_DIR=artifacts
